# Tactica Engine — Firebase web client config
# Same Firebase project as the mobile app (project ID: tactica-backend).
# These are public client identifiers (safe in client-side JS), not secrets,
# but keeping them in env vars means the config lives in one place instead
# of hardcoded in lib/firebase.ts, and can differ per environment if needed.
#
# Copy this file to .env.local for local dev, and add the same keys in
# Vercel's project settings (Environment Variables) for production/preview.

NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyBlbYAyEcKJfmHnSzXzAtDnJECS1IM9iuY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=tactica-backend.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=tactica-backend
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=tactica-backend.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=749983115247
NEXT_PUBLIC_FIREBASE_APP_ID=1:749983115247:web:99314e2040bff8bd76781a
